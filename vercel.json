{
  "buildCommand": "vite build && node_modules/.bin/esbuild server/_core/vercel.ts --platform=node --bundle --format=esm --outfile=api/index.js --packages=external",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/publish-scheduled", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/manus-storage/(.*)", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/rss.xml", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
