{
  "buildCommand": "vite build && node_modules/.bin/esbuild server/_core/vercel.ts --platform=node --bundle --format=esm --outfile=api/index.js --packages=external",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/manus-storage/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
